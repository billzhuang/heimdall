# Anthropic API key (required) — Flue resolves provider credentials from the environment.
ANTHROPIC_API_KEY=your-api-key-here

# Model specifier (optional). Flue uses provider/model specifiers.
# HEIMDALL_MODEL=anthropic/claude-sonnet-4-6

# Kubernetes configuration (optional)
# KUBECONFIG=~/.kube/config
# HEIMDALL_CONTEXT=your-context-name      # pin a default cluster context
# HEIMDALL_NAMESPACE=your-namespace       # pin a default namespace

# EKS dynamic kubeconfig — set these instead of a static KUBECONFIG file.
# When HEIMDALL_EKS_CLUSTER is set, Heimdall runs `aws eks update-kubeconfig`
# on each call to list_contexts and writes the result to a temp file. AWS
# credentials must be available in the environment (env vars, instance profile,
# or IRSA). When running as a pod inside EKS, set neither — Heimdall
# auto-detects the in-cluster service-account token (no kubeconfig needed).
# HEIMDALL_EKS_CLUSTER=my-cluster-name
# HEIMDALL_EKS_REGION=us-east-1          # falls back to AWS_DEFAULT_REGION / AWS_REGION

# kubectl JSON cache (optional)
# HEIMDALL_KUBECTL_CACHE=0                 # set to 0 to disable the cache
# HEIMDALL_KUBECTL_CACHE_TTL=30            # cache TTL in seconds (default: 30)
# HEIMDALL_KUBECTL_CACHE_DIR=/tmp          # override cache directory
