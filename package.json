{
  "name": "heimdall-sre",
  "version": "0.1.0",
  "description": "AI-powered Kubernetes assistant and SRE agent using Claude Agent SDK",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "heimdall": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "kubernetes",
    "eks",
    "sre",
    "ai-agent",
    "claude",
    "k8s",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.11",
    "commander": "^14.0.0",
    "dotenv": "^17.2.3",
    "ink": "^6.6.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@vitest/coverage-v8": "^4.0.17",
    "fast-check": "^4.5.3",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
