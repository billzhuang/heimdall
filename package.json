{
  "name": "heimdall-sre",
  "version": "0.2.0",
  "description": "AI-powered, read-only Kubernetes SRE agent built on the Flue agent framework",
  "type": "module",
  "bin": {
    "heimdall": "bin/heimdall"
  },
  "scripts": {
    "dev": "flue dev --target node",
    "build": "flue build --target node",
    "connect": "flue connect heimdall local --target node",
    "prompt": "bin/heimdall",
    "watch": "tsx src/watch-mode.ts",
    "triage": "tsx src/triage-mode.ts",
    "eval": "tsx src/eval-mode.ts",
    "self-improve": "tsx src/self-improve-mode.ts",
    "self-loop": "tsx src/self-loop-mode.ts",
    "alert": "tsx src/alert-mode.ts",
    "schedule": "tsx src/schedule-mode.ts",
    "mcp": "tsx src/mcp-mode.ts",
    "serve": "tsx src/serve-mode.ts",
    "session": "tsx src/session-mode.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "kubernetes",
    "eks",
    "sre",
    "ai-agent",
    "flue",
    "k8s",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@flue/cli": "^1.0.0-beta.1",
    "@flue/runtime": "^1.0.0-beta.2",
    "@flue/sdk": "^1.0.0-beta.1",
    "@valibot/to-json-schema": "^1.7.1",
    "js-yaml": "^4.2.0",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "fast-check": "^4.8.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
