{
  "name": "heimdall-sre",
  "version": "0.2.0",
  "description": "AI-powered, read-only Kubernetes SRE agent built on Pi Durable",
  "type": "module",
  "bin": {
    "heimdall": "bin/heimdall"
  },
  "scripts": {
    "dev": "tsx src/serve-mode.ts",
    "build": "tsc --noEmit",
    "connect": "tsx src/pi-runner.ts",
    "prompt": "bin/heimdall",
    "watch": "tsx src/watch-mode.ts",
    "triage": "tsx src/triage-mode.ts",
    "eval": "tsx src/eval-mode.ts",
    "self-improve": "tsx src/self-improve-mode.ts",
    "self-loop": "tsx src/self-loop-mode.ts",
    "alert": "tsx src/alert-mode.ts",
    "schedule": "tsx src/schedule-mode.ts",
    "mcp": "tsx src/mcp-mode.ts",
    "serve": "tsx src/serve-mode.ts",
    "agentcore": "tsx src/agentcore-handler.ts",
    "session": "tsx src/session-mode.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/integration.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "kubernetes",
    "eks",
    "sre",
    "ai-agent",
    "pi-durable",
    "k8s",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@earendil-works/chord": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-durable": "^1.5.0",
    "@earendil-works/pi-schema": "^1.5.0",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@valibot/to-json-schema": "^1.8.0",
    "hono": "^4.13.16",
    "js-yaml": "^5.5.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
