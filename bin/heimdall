#!/usr/bin/env bash
# Heimdall CLI — one-shot prompt or proactive watch mode.
# Usage: heimdall -p "Why is my api pod crash-looping?"
#        heimdall --watch
set -euo pipefail

# Resolve symlinks so this works when invoked via `npm install -g` / `npm link`.
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd "$(dirname "$_src")" && pwd)"
unset _src _dir

ROOT_DIR="${SCRIPT_DIR}/.."

# Prefer the project-local flue binary; fall back to PATH (global install).
FLUE="${ROOT_DIR}/node_modules/.bin/flue"
if [[ ! -x "$FLUE" ]]; then
  FLUE="$(command -v flue 2>/dev/null || true)"
fi
if [[ -z "$FLUE" ]] || [[ ! -x "$FLUE" ]]; then
  echo "Error: flue CLI not found. Run 'npm install' in the project root first." >&2
  exit 1
fi

# tsx is used to run the TypeScript watch-mode script directly in development.
TSX="${ROOT_DIR}/node_modules/.bin/tsx"

show_help() {
  cat <<EOF
Usage: heimdall -p <prompt> [--json]
       heimdall --watch
       heimdall triage [-n <namespace>] [-A]
       heimdall eval [--scenario <name>]
       heimdall self-improve [--scenario <name>] [--reflect] [--from-log]

Run the Heimdall Kubernetes SRE agent.

Options:
  -p, --prompt <text>   Send a single prompt to the agent and exit
  -w, --watch           Start proactive Warning-event monitor (streams until interrupted)
      --json            Emit a single JSON object to stdout (one-shot mode only)
      --format json     Alias for --json
      --no-learn        Skip appending this investigation to the task-history log
      --backend <name>  LLM backend: 'flue' (default) or 'claude-cli'
                        Override with env var HEIMDALL_BACKEND=claude-cli.
                        'claude-cli' calls \`claude -p\` directly (no tool use;
                        requires the Claude Code CLI to be installed and authenticated).
  -h, --help            Show this help message

Subcommands:
  triage                Run a structured whole-cluster health sweep with severity-ranked findings
    -n, --namespace <ns>  Scope the sweep to a single namespace
    -A, --all-namespaces  Sweep all namespaces
  eval                  Run synthetic RCA evaluation against known failure scenarios
  self-improve          Run evals and record failures as learning entries for instruction improvement
    --reflect             After running, print a meta-prompt for proposing instruction fixes
    --from-log            Reflect on existing scenarios/learning-log.jsonl instead of re-running evals

Examples:
  heimdall -p "Why is my frontend deployment crash-looping in prod?"
  heimdall -p "Audit RBAC in prod" --json           # machine-readable output
  heimdall -p "Audit RBAC in prod" --json | jq .    # pretty-print JSON
  heimdall --watch                        # monitor all namespaces
  heimdall --watch 2>/dev/null | jq .     # pretty-print watch findings
  heimdall triage                         # full health sweep (default namespace)
  heimdall triage -A                      # sweep all namespaces
  heimdall triage -n prod                 # sweep only the prod namespace
  heimdall eval                           # run all eval scenarios
  heimdall eval --scenario crashloop      # run only matching scenarios
  heimdall self-improve                   # run evals, record failures in learning log
  heimdall self-improve --reflect         # run evals + print reflection prompt
  heimdall self-improve --reflect --from-log  # reflect on prior failures

JSON output schema (--json):
  { "summary": "…", "answer": "…", "severity": "warning",
    "suggestedCommands": ["kubectl …"], "model": "anthropic/…" }

Backends:
  flue (default)  Full Flue agent with kubectl/helm/Prometheus tool use.
                  Requires ANTHROPIC_API_KEY (or another provider key).
  claude-cli      One-shot call to \`claude -p\`. No tool use. Requires the
                  Claude Code CLI (\`claude\`) to be installed and authenticated.

Watch mode reads the 'watch:' block from heimdall.config.yaml for
namespace/reason filters and an optional webhook URL.

Environment variables are read from .env (see .env.example).
For interactive mode use: npm run connect
EOF
}

PROMPT=""
WATCH=false
TRIAGE=false
TRIAGE_ARGS=()
EVAL=false
EVAL_ARGS=()
SELF_IMPROVE=false
SELF_IMPROVE_ARGS=()
JSON_OUTPUT=false
NO_LEARN=false
# Backend: 'flue' (default, full agent with tool use) or 'claude-cli' (external LLM via claude -p).
BACKEND="${HEIMDALL_BACKEND:-flue}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    triage)
      TRIAGE=true
      shift
      # Pass remaining args to the triage script.
      TRIAGE_ARGS=("$@")
      break
      ;;
    eval)
      EVAL=true
      shift
      # Pass remaining args to the eval script.
      EVAL_ARGS=("$@")
      break
      ;;
    self-improve)
      SELF_IMPROVE=true
      shift
      # Pass remaining args to the self-improve script.
      SELF_IMPROVE_ARGS=("$@")
      break
      ;;
    -p|--prompt)
      [[ $# -lt 2 ]] && { echo "Error: -p requires an argument" >&2; exit 1; }
      PROMPT="$2"
      shift 2
      ;;
    -w|--watch)
      WATCH=true
      shift
      ;;
    --json)
      JSON_OUTPUT=true
      shift
      ;;
    --format)
      [[ $# -lt 2 ]] && { echo "Error: --format requires an argument" >&2; exit 1; }
      case "$2" in
        json) JSON_OUTPUT=true ;;
        *) echo "Error: unknown format '$2'; only 'json' is supported" >&2; exit 1 ;;
      esac
      shift 2
      ;;
    --no-learn)
      NO_LEARN=true
      shift
      ;;
    --backend)
      [[ $# -lt 2 ]] && { echo "Error: --backend requires an argument" >&2; exit 1; }
      case "$2" in
        flue|claude-cli) BACKEND="$2" ;;
        *) echo "Error: unknown backend '$2'; supported: flue, claude-cli" >&2; exit 1 ;;
      esac
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    --)
      shift
      PROMPT="$*"
      break
      ;;
    -*)
      echo "Error: unknown option: $1" >&2
      show_help >&2
      exit 1
      ;;
    *)
      echo "Error: unexpected argument '$1' — use -p to pass a prompt, 'triage' for a health sweep, 'eval' for synthetic RCA evaluation, or 'self-improve' for the self-improvement loop" >&2
      show_help >&2
      exit 1
      ;;
  esac
done

# --- Incompatible-flag checks ---------------------------------------------
if [[ "$JSON_OUTPUT" == "true" ]] && [[ "$WATCH" == "true" ]]; then
  echo "Error: --json is not compatible with --watch (watch mode already emits JSON lines)" >&2
  exit 1
fi
if [[ "$JSON_OUTPUT" == "true" ]] && [[ "$TRIAGE" == "true" ]]; then
  echo "Error: --json is not compatible with the triage subcommand" >&2
  exit 1
fi
if [[ "$JSON_OUTPUT" == "true" ]] && [[ "$SELF_IMPROVE" == "true" ]]; then
  echo "Error: --json is not compatible with the self-improve subcommand" >&2
  exit 1
fi
if [[ "$BACKEND" == "claude-cli" ]] && [[ "$WATCH" == "true" ]]; then
  echo "Error: --backend claude-cli is not compatible with --watch" >&2
  exit 1
fi
if [[ "$BACKEND" == "claude-cli" ]] && [[ "$TRIAGE" == "true" ]]; then
  echo "Error: --backend claude-cli is not compatible with the triage subcommand" >&2
  exit 1
fi
if [[ "$BACKEND" == "claude-cli" ]] && [[ "$EVAL" == "true" ]]; then
  echo "Error: --backend claude-cli is not compatible with the eval subcommand" >&2
  exit 1
fi
if [[ "$BACKEND" == "claude-cli" ]] && [[ "$SELF_IMPROVE" == "true" ]]; then
  echo "Error: --backend claude-cli is not compatible with the self-improve subcommand" >&2
  exit 1
fi

# --- Triage mode ----------------------------------------------------------
if [[ "$TRIAGE" == "true" ]]; then
  TRIAGE_COMPILED="${ROOT_DIR}/dist/triage-mode.mjs"
  TRIAGE_SOURCE="${ROOT_DIR}/src/triage-mode.ts"

  if [[ -f "$TRIAGE_COMPILED" ]]; then
    exec node "$TRIAGE_COMPILED" "${TRIAGE_ARGS[@]}"
  elif [[ -x "$TSX" ]] && [[ -f "$TRIAGE_SOURCE" ]]; then
    exec "$TSX" "$TRIAGE_SOURCE" "${TRIAGE_ARGS[@]}"
  else
    echo "Error: triage mode not available." >&2
    echo "  Production: run 'npm run build' first." >&2
    echo "  Development: run 'npm install' to get tsx." >&2
    exit 1
  fi
fi

# --- Self-improve mode ----------------------------------------------------
if [[ "$SELF_IMPROVE" == "true" ]]; then
  SELF_IMPROVE_COMPILED="${ROOT_DIR}/dist/self-improve-mode.mjs"
  SELF_IMPROVE_SOURCE="${ROOT_DIR}/src/self-improve-mode.ts"

  if [[ -f "$SELF_IMPROVE_COMPILED" ]]; then
    exec node "$SELF_IMPROVE_COMPILED" "${SELF_IMPROVE_ARGS[@]}"
  elif [[ -x "$TSX" ]] && [[ -f "$SELF_IMPROVE_SOURCE" ]]; then
    exec "$TSX" "$SELF_IMPROVE_SOURCE" "${SELF_IMPROVE_ARGS[@]}"
  else
    echo "Error: self-improve mode not available." >&2
    echo "  Production: run 'npm run build' first." >&2
    echo "  Development: run 'npm install' to get tsx." >&2
    exit 1
  fi
fi

# --- Eval mode ------------------------------------------------------------
if [[ "$EVAL" == "true" ]]; then
  EVAL_COMPILED="${ROOT_DIR}/dist/eval-mode.mjs"
  EVAL_SOURCE="${ROOT_DIR}/src/eval-mode.ts"

  if [[ -f "$EVAL_COMPILED" ]]; then
    exec node "$EVAL_COMPILED" "${EVAL_ARGS[@]}"
  elif [[ -x "$TSX" ]] && [[ -f "$EVAL_SOURCE" ]]; then
    exec "$TSX" "$EVAL_SOURCE" "${EVAL_ARGS[@]}"
  else
    echo "Error: eval mode not available." >&2
    echo "  Production: run 'npm run build' first." >&2
    echo "  Development: run 'npm install' to get tsx." >&2
    exit 1
  fi
fi

# --- Watch mode -----------------------------------------------------------
if [[ "$WATCH" == "true" ]]; then
  WATCH_COMPILED="${ROOT_DIR}/dist/watch-mode.mjs"
  WATCH_SOURCE="${ROOT_DIR}/src/watch-mode.ts"

  if [[ -f "$WATCH_COMPILED" ]]; then
    # Production path: use the pre-built JS bundle (npm run build).
    exec node "$WATCH_COMPILED"
  elif [[ -x "$TSX" ]] && [[ -f "$WATCH_SOURCE" ]]; then
    # Development path: run the TypeScript source directly via tsx.
    exec "$TSX" "$WATCH_SOURCE"
  else
    echo "Error: watch mode not available." >&2
    echo "  Production: run 'npm run build' first." >&2
    echo "  Development: run 'npm install' to get tsx." >&2
    exit 1
  fi
fi

# --- One-shot prompt mode -------------------------------------------------
if [[ -z "$PROMPT" ]]; then
  echo "Error: a prompt is required  (-p <text>),  use --watch for event monitoring," >&2
  echo "       or use 'triage' for a whole-cluster health sweep" >&2
  show_help >&2
  exit 1
fi

# ---- claude-cli backend: delegate to `claude -p` -------------------------
if [[ "$BACKEND" == "claude-cli" ]]; then
  # Verify the CLI is available before trying to invoke it.
  if ! command -v claude &>/dev/null; then
    echo "Error: claude CLI not found. Install the Claude Code CLI and run 'claude auth login'." >&2
    exit 1
  fi

  if [[ "$JSON_OUTPUT" == "true" ]]; then
    FORMAT_JSON_COMPILED="${ROOT_DIR}/dist/format-json.mjs"
    FORMAT_JSON_SOURCE="${ROOT_DIR}/src/format-json.ts"

    _LEARN_ENV_ARGS=()
    [[ "$NO_LEARN" == "true" ]] && _LEARN_ENV_ARGS=("HEIMDALL_NO_LEARN=1")

    if [[ -f "$FORMAT_JSON_COMPILED" ]]; then
      claude -p "$PROMPT" | \
        env HEIMDALL_PROMPT="$PROMPT" "${_LEARN_ENV_ARGS[@]}" node "$FORMAT_JSON_COMPILED"
    elif [[ -x "$TSX" ]] && [[ -f "$FORMAT_JSON_SOURCE" ]]; then
      claude -p "$PROMPT" | \
        env HEIMDALL_PROMPT="$PROMPT" "${_LEARN_ENV_ARGS[@]}" "$TSX" "$FORMAT_JSON_SOURCE"
    else
      echo "Error: JSON formatter not available." >&2
      echo "  Production: run 'npm run build' first." >&2
      echo "  Development: run 'npm install' to get tsx." >&2
      exit 1
    fi
  else
    claude -p "$PROMPT"
  fi
  exit $?
fi

# ---- flue backend (default) ----------------------------------------------
if [[ "$JSON_OUTPUT" == "true" ]]; then
  FORMAT_JSON_COMPILED="${ROOT_DIR}/dist/format-json.mjs"
  FORMAT_JSON_SOURCE="${ROOT_DIR}/src/format-json.ts"

  # Pass the original prompt and no-learn flag to format-json so it can log
  # task-history entries. HEIMDALL_NO_LEARN=1 skips logging for this run.
  _LEARN_ENV_ARGS=()
  [[ "$NO_LEARN" == "true" ]] && _LEARN_ENV_ARGS=("HEIMDALL_NO_LEARN=1")

  if [[ -f "$FORMAT_JSON_COMPILED" ]]; then
    printf '%s\n' "$PROMPT" | "$FLUE" connect heimdall local --target node | \
      env HEIMDALL_PROMPT="$PROMPT" "${_LEARN_ENV_ARGS[@]}" node "$FORMAT_JSON_COMPILED"
  elif [[ -x "$TSX" ]] && [[ -f "$FORMAT_JSON_SOURCE" ]]; then
    printf '%s\n' "$PROMPT" | "$FLUE" connect heimdall local --target node | \
      env HEIMDALL_PROMPT="$PROMPT" "${_LEARN_ENV_ARGS[@]}" "$TSX" "$FORMAT_JSON_SOURCE"
  else
    echo "Error: JSON formatter not available." >&2
    echo "  Production: run 'npm run build' first." >&2
    echo "  Development: run 'npm install' to get tsx." >&2
    exit 1
  fi
else
  printf '%s\n' "$PROMPT" | "$FLUE" connect heimdall local --target node
fi
